FROM node:18-alpine
WORKDIR /app

# הגדרת משתנים להזרקה בזמן הבילד
ARG VERSION=1.0.0
ARG DATE=unknown
# הפיכתם למשתני סביבה זמינים בתוך הקוד
ENV BUILD_VERSION=$VERSION
ENV BUILD_DATE=$DATE

COPY package*.json ./
RUN npm install
COPY . .
EXPOSE 3000
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
   CMD node -e "fetch('http://localhost:3000/health').then(res => process.exit!(res.ok ? 0 : 1)).catch(() => process(1))"
CMD ["node", "server.js"]